# Anchorflow — reverse proxy to the standalone server on 127.0.0.1:3004.
#
# Production truth for this tool is PM2 + nginx + certbot on the VPS
# (see DEPLOYMENT_PLAYBOOK.md at the repo root): the process runs as
# `anchor-norai` and nginx terminates TLS for anchor.norai.tech. This Caddyfile
# is the parallel Docker path (context.md Appendix A item 3: ship both).

anchor.norai.tech {
    encode gzip zstd
    reverse_proxy anchorflow:3004 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
