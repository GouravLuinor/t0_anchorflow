        "700": "82 86 76",
        "800": "52 56 48",
        "900": "30 33 27",
        "950": "12 14 11"
      }
    }
  },
  "typography": {
    "sans": {
      "family": "Inter",
      "cssVar": "--font-inter",
      "fontClass": "font-sans",
      "usage": "All headings, UI, labels, body, nav. One tuned sans only.",
      "headingTracking": [
        "-0.025em",
        "-0.04em"
      ]
    },
    "mono": {
      "family": "JetBrains Mono",
      "cssVar": "--font-jetbrains-mono",
      "fontClass": "font-mono",
      "usage": "Code and data only: the workflow YAML editor, the diagnostic echo, offset/timing metrics, ref tokens, receipt endpoints and small data captions.",
      "note": "Mono is never decorative."
    },
    "scale": {
      "sizing": "Fixed rem scale (no clamp).",
      "ratio": 1.18,
      "numeric": "tabular-nums on all numeric readouts (offsets, indices, counts, ms).",
      "proseMeasure": "~68ch"
    }
  },
  "spacing": {
    "base": 4,
    "unit": "px",
    "grid": [
      4,
      8
    ],
    "note": "4px/8px modular grid only; no arbitrary Tailwind values (p-[13px], w-[317px])."
  },
  "radii": {
    "control": "0.5rem",
    "card": [
      "0.75rem",
      "1rem"
    ]
  },
  "shadows": {
    "elevated": "0 12px 40px rgb(var(--ink)/0.10)",
    "raycast": "0 1px 2px rgb(var(--ink)/0.08), inset 0 1px 0 0 rgb(255 255 255/0.6)",
    "note": "Declare elevation once (border OR shadow, not both). No decorative glow."
  },
  "utilities": {
    "glassEdge": "Crisp 1px top hairline (white/0.9 light, white/0.05 dark) + soft elevation. No blur.",
    "glassEdgeSubtle": "Hairline only, no elevation.",
    "scanSweep": "One authored motion: a single lime hairline sweeping across x once when a diagnostic settles. Applied to the diagnostic pane's bottom hairline."
  },
  "motion": {
    "easing": {
      "out-expo": "cubic-bezier(0.16,1,0.3,1)"
    },
    "duration": {
      "150": "150ms",
      "180": "180ms",
      "300": "300ms"
    },
    "scanSweep": {
      "utilityClass": "scan-sweep",
      "description": "One authored motion: a single lime hairline sweep when a diagnostic settles.",
      "duration": "400ms",
      "easing": "cubic-bezier(0.16,1,0.3,1)",
      "reducedMotion": "Guarded by the prefers-reduced-motion kill-switch in globals.css."
    }
  },
  "interactionStates": [
    "idle",
    "hover (border-surface-borderHover + subtle bg shift)",
    "active (scale-[0.97])",
    "focus-visible (ring-2 ring-brand-lime/40, outline-none)",
    "disabled/loading (opacity-50, cursor-not-allowed)"
  ],
  "colorClassNames": {
    "surfaces": [
      "bg-canvas",
      "text-ink",
      "bg-surface-base",
      "bg-surface-subtle",
      "bg-surface-default",
      "bg-surface-elevated",
      "border-surface-border",
      "border-surface-borderHover"
    ],
    "brand": [
      "text-brand-lime",
      "bg-brand-lime",
      "border-brand-lime",
      "text-brand-violet",
      "bg-brand-violet",
      "border-brand-violet",
      "text-brand-amber",
      "bg-brand-amber",
      "border-brand-amber",
      "text-brand-rose",
      "bg-brand-rose",
      "border-brand-rose"
    ],
    "code": [
      "text-code-keyword",
      "text-code-type",
      "text-code-prop",
      "text-code-str",
      "text-code-num",
      "text-code-punct",
      "text-code-comment"
    ],
    "invertedZinc": [
      "text-zinc-50",
      "text-zinc-100",
      "text-zinc-200",
      "text-zinc-300",
      "text-zinc-400",
      "text-zinc-500",
      "text-zinc-600",
      "text-zinc-700",
      "text-zinc-800",
      "text-zinc-900",
      "text-zinc-950"
    ],
    "note": "Colors only from these token classes; no raw sky/emerald/indigo/purple or default Tailwind palette. Use /opacity modifiers for tints (bg-brand-lime/10, border-brand-lime/40)."
  },
  "domain": "GitHub Actions workflow pinning, permission auditing and diffing",
  "accentNote": "One accent (brand-lime) is spent on exactly what Anchorflow is about: a pin, a primary action, the privacy promise, and the success state. Semantic violet/amber/rose are secondary/warn/error only.",
  "semanticMapping": {
    "lime": "pinned / match / primary / the privacy promise",
    "violet": "capture / secondary scope",
    "amber": "warn / degraded / truncation / rate-limit",
    "rose": "error finding / copy-failure toast"
  }
}
