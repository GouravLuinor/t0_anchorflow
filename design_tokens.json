{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Anchorflow Design Tokens",
  "slug": "anchorflow",
  "category": "CI/CD Security",
  "version": "1.0.0",
  "colorSpace": "srgb",
  "tokenFormat": "Space-separated RGB triplets; consumed as rgb(var(--token)/<alpha-value>) in CSS and rgb(var(--token)/<alpha-value>) in tailwind.config.ts so every /opacity modifier works in both themes.",
  "sourceOfTruth": [
    "app/globals.css",
    "tailwind.config.ts"
  ],
  "themes": {
