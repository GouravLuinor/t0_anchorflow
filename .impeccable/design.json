  "narrative": {
    "northStar": "A certified copy of your workflow.",
    "overview": "Anchorflow is security printing. Pale tinted paper, intaglio ink, fine guilloché lattices and a seal that says this copy matches the original. Pinning an action trades a ref that can move for a commit that cannot; the page hands back a certified copy with a seal on every pin and a receipt for how each was resolved.",
    "keyCharacteristics": [
      "Security-paper green ground, intaglio-green ink, one seal green.",
      "Every pinned row wears a guilloché seal generated from its own SHA.",
      "Machine data in condensed Martian Mono; everything else in Schibsted Grotesk.",
      "2px corners, 1px rules, no panel shadows.",
      "A verdict sentence leads; the ledger and the report follow."
    ],
    "rules": [
      {
        "name": "The One Job Rule",
        "section": "Colors",
        "body": "Seal green means pinned or primary; indigo means moving; vermilion and ochre are finding grades. No colour is borrowed for decoration."
      },
      {
        "name": "The Measured Contrast Rule",
        "section": "Colors",
        "body": "Every text role clears 4.5:1 on paper, sheet, band and the composited wells and tints, in both themes. contrast.test.ts parses globals.css and fails the build when one does not."
      },
      {
        "name": "The Machine Data Rule",
        "section": "Typography",
        "body": "Mono means a machine wrote it. A label, a heading or a button is never mono."
      }
    ],
    "dos": [
      "Lead the certified copy with one sentence and one next step.",
      "Say loading when loading, and name the error and where it is.",
      "Show the receipt for every network-resolved pin.",
      "Keep every claim in the comparison true of the category, not a named brand."
    ],
    "donts": [
      "Use eyebrows, icon-card grids, hero metrics, 01/02 numbering, gradient text, glass, or a coloured border-left over 1px.",
      "Use the guilloché pattern as a background.",
      "Use mono for labels or headings.",
      "Open a modal the visitor did not ask for."
    ]
